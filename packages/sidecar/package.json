{
  "name": "@dahara/sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "pretest": "npm run build -w @dahara/shared",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@dahara/shared": "*",
    "irsdk-node": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0"
  }
}
